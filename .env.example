# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:6543/postgres?sslmode=require"

# OpenRouter AI
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL="openai/gpt-oss-20b:free"

# NextAuth
NEXTAUTH_URL="https://yourdomain.com"
NEXTAUTH_SECRET="generate-a-random-secret"
NEXTAUTH_URL_INTERNAL="http://localhost:3000"

# SMTP Email (Gmail recommended)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM_EMAIL="your-email@gmail.com"

# Google Calendar (Service Account)
GOOGLE_CALENDAR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_CLIENT_EMAIL="your-service@project.iam.gserviceaccount.com"
GOOGLE_CALENDAR_ID="primary"
GOOGLE_CALENDAR_PROJECT_ID="your-project-id"
GOOGLE_CALENDAR_PRIVATE_KEY_ID="your-key-id"

# Google Sheets (Optional CRM sync)
GOOGLE_SHEETS_PRIVATE_KEY=""
GOOGLE_SHEETS_CLIENT_EMAIL=""
GOOGLE_SHEETS_SPREADSHEET_ID=""

# Coaching business config
COACH_TIMEZONE="Asia/Karachi"
